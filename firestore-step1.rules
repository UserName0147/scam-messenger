rules_version = '2';

// ШАГ 1 — временные правила. Публиковать МОЖНО ПРЯМО СЕЙЧАС.
//
// Задача: закрыть базу от анонимов. Сейчас стоит `allow read, write: if true`,
// то есть любой человек в интернете читает/меняет/удаляет всю базу без регистрации.
//
// Что даёт: аноним не может ничего. Старый клиент на Vercel продолжает работать,
// потому что все его пользователи входят через Firebase Auth.
//
// Чего НЕ даёт: приватности между пользователями. Любой авторизованный
// по-прежнему может прочитать все сообщения. Это чинит ШАГ 2 (firestore.rules),
// но его можно публиковать только после деплоя нового клиента.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isDev() {
      return signedIn()
        && 'email' in request.auth.token
        && request.auth.token.email == 'p8973113@gmail.com';
    }

    // Экран обслуживания читает этот документ ДО входа — поэтому чтение публичное.
    // Включать/выключать режим обслуживания может только создатель.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isDev();
    }

    // Всё остальное — только авторизованным.
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
